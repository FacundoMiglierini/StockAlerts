# Used by docker-compose.yml when running the full stack (postgres + backend).
POSTGRES_USER=stockalerts
POSTGRES_PASSWORD=stockalerts
POSTGRES_DB=stockalerts

JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=604800

# Bootstrap admin account created by the backend's seed step on first boot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Backend: used to build the link inside password-reset emails
# (frontendUrl/reset-password?token=...) — no trailing slash.
FRONTEND_URL=http://localhost:5173

# Backend: sends password-reset emails only (not alarm notifications —
# see worker/CLAUDE.md for those). Separate from WORKER_MAIL_* below so
# each service's config is independent, even when pointed at the same
# mailbox.
BACKEND_MAIL_HOST=smtp.gmail.com
BACKEND_MAIL_PORT=465
BACKEND_MAIL_USERNAME=Stock Alerts
BACKEND_MAIL_EMAIL=you@example.com
BACKEND_MAIL_PASSWORD=

# Frontend (baked in at build time — see docker-compose.yml)
VITE_API_URL=http://localhost:3000

# Worker
WORKER_PRICE_HISTORY_PERIOD=1y
WORKER_POLL_INTERVAL_SECONDS=3600
WORKER_FINNHUB_API_KEY=
WORKER_FINNHUB_HISTORY_ENABLED=false
# Optional — override only for a proxy/mock/self-hosted mirror of Finnhub's API.
WORKER_FINNHUB_BASE_URL=https://finnhub.io/api/v1
WORKER_MAIL_HOST=smtp.gmail.com
WORKER_MAIL_PORT=465
WORKER_MAIL_USERNAME=Stock Alerts
WORKER_MAIL_EMAIL=you@example.com
WORKER_MAIL_PASSWORD=
WORKER_TELEGRAM_BOT_TOKEN=
# Optional — override only for a self-hosted Telegram Bot API server or a test double.
WORKER_TELEGRAM_API_BASE_URL=https://api.telegram.org
