DATABASE_URL="postgresql://stockalerts:stockalerts@localhost:5432/stockalerts?schema=public"

WORKER_PRICE_HISTORY_PERIOD=1y
WORKER_POLL_INTERVAL_SECONDS=3600

# Optional — omit to go straight to the yfinance fallback. Note: Finnhub's
# free tier returns 403 on historical daily candles (paid-plan-only), so
# this is only useful once WORKER_FINNHUB_HISTORY_ENABLED=true, i.e. once
# you've upgraded past the free tier. See worker/CLAUDE.md.
WORKER_FINNHUB_API_KEY=
WORKER_FINNHUB_HISTORY_ENABLED=false
# Optional — override only for a proxy/mock/self-hosted mirror of Finnhub's API.
WORKER_FINNHUB_BASE_URL=https://finnhub.io/api/v1

WORKER_MAIL_HOST=smtp.gmail.com
WORKER_MAIL_PORT=465
WORKER_MAIL_USERNAME=Stock Alerts
WORKER_MAIL_EMAIL=you@example.com
WORKER_MAIL_PASSWORD=

# Free — no per-message cost. Get a token from @BotFather on Telegram, then
# each user links their own chat id via PATCH /users/me (see worker/CLAUDE.md).
WORKER_TELEGRAM_BOT_TOKEN=
# Optional — override only for a self-hosted Telegram Bot API server (see
# https://github.com/tdlib/telegram-bot-api) or a test double.
WORKER_TELEGRAM_API_BASE_URL=https://api.telegram.org
